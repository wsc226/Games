{
  "_version": 1,
  "_status": "draft - Japanese + English, ready for voice cloning",
  "_readme": "All spoken lines for train-205.html. Edit 'lines' (ja/en templates). Station lines (per_station) can use {name} (this station), {next} (the next station) and {transfer}. 'only': 'transfer' = stations with connecting lines, 'last' = Utsunomiya only; 'skip_first' / 'skip_last' leave out Tokyo / Utsunomiya. Then run `node tools/build_train_205.mjs` - it regenerates 'renders' (every final sentence with its target audio file) and re-embeds this file into train-205.html. Any render whose audio file exists is played; otherwise the game falls back to the iPad's text-to-speech using the same text and language.",
  "_how_to_record": "Clone each voice in 'voices', then render every entry in 'renders' to its 'file' path (mp3). Japanese files live under audio/train-205/ja/, English under audio/train-205/en/; 'common' folders are shared by all stations. Each render has a 'when' note saying when the game plays it. Real sound effects (horn, door chime, departure melodies, crossing bell...) can be dropped in at the paths listed in 'sfx' - any file that exists replaces the built-in synthesised sound. See audio/train-205/README.md.",
  "voices": {
    "conductor": {
      "description": "Train conductor (車掌). Calm, nasal, sing-song JR PA voice.",
      "rate": 0.95,
      "pitch": 1
    },
    "auto": {
      "description": "Automatic train announcement. Clear, bright female voice (JR East style).",
      "rate": 0.95,
      "pitch": 1.1
    },
    "platform": {
      "description": "Station platform announcer. Echoey, polite female voice.",
      "rate": 0.95,
      "pitch": 1.05
    },
    "driver": {
      "description": "The player's train driver callouts (指差喚呼). Short, crisp, enthusiastic.",
      "rate": 1.05,
      "pitch": 1
    },
    "announcer": {
      "description": "Race announcer. Excited, cheerful, kid-friendly (like a sports-day MC).",
      "rate": 1.05,
      "pitch": 1.15
    }
  },
  "lines": [
    {
      "id": "welcome",
      "role": "auto",
      "when": "Game start at Tokyo",
      "ja": "今日も、JR東日本をご利用いただきまして、ありがとうございます。この電車は、宇都宮線、宇都宮行きです。",
      "en": "Thank you for riding JR East. This is the Utsunomiya Line train bound for Utsunomiya."
    },
    {
      "id": "approaching",
      "role": "auto",
      "when": "700 m before a station",
      "per_station": true,
      "skip_first": true,
      "skip_last": true,
      "ja": "まもなく、{name}です。お出口は、左側です。",
      "en": "We will soon make a brief stop at {name}. The doors on the left side will open."
    },
    {
      "id": "approaching_last",
      "role": "auto",
      "when": "700 m before Utsunomiya",
      "per_station": true,
      "only": "last",
      "ja": "まもなく、終点、{name}です。お出口は、左側です。今日も、ご乗車ありがとうございました。",
      "en": "We will soon arrive at {name}, the last stop. The doors on the left side will open. Thank you for riding with us today."
    },
    {
      "id": "transfer",
      "role": "auto",
      "when": "After the approaching announcement",
      "per_station": true,
      "only": "transfer",
      "skip_first": true,
      "ja": "{transfer}は、お乗り換えです。",
      "en": "Please change here for {transfer}."
    },
    {
      "id": "arrived",
      "role": "conductor",
      "when": "Doors open at a station",
      "per_station": true,
      "skip_first": true,
      "skip_last": true,
      "ja": "{name}、{name}です。ご乗車、ありがとうございます。",
      "en": "{name}. {name}. Thank you for riding."
    },
    {
      "id": "arrived_last",
      "role": "conductor",
      "when": "Doors open at Utsunomiya",
      "per_station": true,
      "only": "last",
      "ja": "{name}、{name}、終点です。お忘れ物の、ございませんよう、ご注意ください。",
      "en": "{name}. This is the last stop. Please make sure you have all your belongings."
    },
    {
      "id": "doors_open",
      "role": "auto",
      "when": "Doors start opening",
      "ja": "ドアが開きます。",
      "en": "The doors are opening."
    },
    {
      "id": "doors_close",
      "role": "conductor",
      "when": "Doors start closing (after the departure melody)",
      "ja": "ドアが閉まります。ご注意ください。",
      "en": "The doors are closing. Please be careful."
    },
    {
      "id": "next",
      "role": "auto",
      "when": "Leaving a station",
      "per_station": true,
      "skip_last": true,
      "ja": "次は、{next}です。",
      "en": "The next station is {next}."
    },
    {
      "id": "platform_arriving",
      "role": "platform",
      "when": "Platform camera, train coming",
      "ja": "まもなく、1番線に、宇都宮行きが、参ります。危ないですから、黄色い線の内側まで、お下がりください。",
      "en": "A train bound for Utsunomiya is now arriving at track number one. For your safety, please stand behind the yellow line."
    },
    {
      "id": "platform_departing",
      "role": "platform",
      "when": "Platform camera, departure melody",
      "ja": "1番線、ドアが閉まります。ご注意ください。",
      "en": "The doors on track number one are closing. Please be careful."
    },
    {
      "id": "close_doors_first",
      "role": "driver",
      "when": "Go pressed while the doors are open",
      "ja": "ドアを しめてから、しゅっぱつ しよう！",
      "en": "Close the doors first, then we can go!"
    },
    {
      "id": "press_doors",
      "role": "driver",
      "when": "Stopped at a platform (hint)",
      "ja": "ドアボタンを おしてね！",
      "en": "Press the Doors button!"
    },
    {
      "id": "perfect_stop",
      "role": "driver",
      "when": "Stopped right at the 3 marker",
      "ja": "ぴったり、ていし！すごい！",
      "en": "Perfect stop! Great job!"
    },
    {
      "id": "passed_station",
      "role": "driver",
      "when": "Drove past a station",
      "ja": "あっ、とおりすぎちゃった！つぎの えきで とまろう。",
      "en": "Oops, we passed the station! Let's stop at the next one."
    },
    {
      "id": "departure_ok",
      "role": "driver",
      "when": "Departing, signal green",
      "ja": "しゅっぱつ、しんこう！",
      "en": "Signal is green. Let's go!"
    },
    {
      "id": "race_intro",
      "role": "announcer",
      "when": "Race start at Omiya",
      "ja": "大宮から宇都宮まで、HU300と、きょうそうだ！",
      "en": "It's a race from Omiya to Utsunomiya against the HU300!"
    },
    {
      "id": "race_go",
      "role": "announcer",
      "when": "Countdown reaches GO",
      "ja": "スタート！",
      "en": "Go!"
    },
    {
      "id": "race_lead_205",
      "role": "announcer",
      "when": "The 205 takes the lead",
      "ja": "205系が、リードしています！",
      "en": "The 205 is in the lead!"
    },
    {
      "id": "race_lead_hu300",
      "role": "announcer",
      "when": "The HU300 takes the lead",
      "ja": "HU300が、前に出ました！がんばれ！",
      "en": "The HU300 is ahead! Keep going!"
    },
    {
      "id": "race_close",
      "role": "announcer",
      "when": "Trains neck and neck",
      "ja": "せっせんです！どっちが勝つかな？",
      "en": "It's a close race! Who will win?"
    },
    {
      "id": "race_hidden",
      "role": "announcer",
      "when": "HU300 leaves on its own track",
      "ja": "あれ？HU300が、見えなくなった！",
      "en": "Where did the HU300 go?"
    },
    {
      "id": "race_back",
      "role": "announcer",
      "when": "HU300 comes back",
      "ja": "HU300が、もどってきた！",
      "en": "The HU300 is back!"
    },
    {
      "id": "race_final",
      "role": "announcer",
      "when": "About 1 km before the finish",
      "ja": "もうすぐゴール、宇都宮です！",
      "en": "Almost at the finish line, Utsunomiya!"
    },
    {
      "id": "race_win",
      "role": "announcer",
      "when": "The 205 wins",
      "ja": "やったー！205系の勝ち！おめでとう！",
      "en": "Hooray! The 205 wins! Congratulations!"
    },
    {
      "id": "race_lose",
      "role": "announcer",
      "when": "The HU300 wins",
      "ja": "HU300の勝ち！つぎは、がんばろう！",
      "en": "The HU300 wins this time! Let's try again!"
    },
    {
      "id": "yellow_signal",
      "role": "driver",
      "when": "A yellow (caution) signal ahead",
      "ja": "きいろ しんごう！スピードを おとそう。",
      "en": "Yellow signal! Let's slow down."
    },
    {
      "id": "slow_good",
      "role": "driver",
      "when": "He pressed Slow for the yellow signal",
      "ja": "じょうず！ゆっくり すすもう。",
      "en": "Good job! Nice and slow."
    },
    {
      "id": "green_again",
      "role": "driver",
      "when": "Past the yellow signal, next one is green",
      "ja": "みどり しんごう。はやく してもいいよ！",
      "en": "Green signal. We can go fast again!"
    },
    {
      "id": "tunnel",
      "role": "driver",
      "when": "Coming up to a tunnel",
      "ja": "トンネルに はいるよ！",
      "en": "Here comes a tunnel!"
    },
    {
      "id": "bridge",
      "role": "driver",
      "when": "Coming up to a big river bridge",
      "ja": "おおきな てっきょうを わたるよ！",
      "en": "We're crossing a big bridge!"
    },
    {
      "id": "crossing_horn",
      "role": "driver",
      "when": "Horn sign before a level crossing",
      "ja": "ふみきりだ。ホーンを ならそう！",
      "en": "A railroad crossing! Let's blow the horn!"
    },
    {
      "id": "shinkansen",
      "role": "driver",
      "when": "An E5 Shinkansen passes on the viaduct",
      "ja": "しんかんせんが きた！はやい！",
      "en": "Here comes the Shinkansen! So fast!"
    }
  ],
